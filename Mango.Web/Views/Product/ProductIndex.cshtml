@model IEnumerable<ProductDto>

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h1 class="text-white">Products List</h1>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-action="ProductCreate" class="btn btn-outline-primary"><i class="bi bi-plus-square"></i> Create New Product</a>
            </div>
        </div>
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;" alt="@item.Name" />
                                }
                                else
                                {
                                    <img src="https://placehold.co/60x60" style="width: 60px; height: 60px; border-radius: 5px;" alt="No image" />
                                }
                            </td>
                            <td>
                                @item.Name
                            </td>
                            <td>
                                @item.CategoryName
                            </td>
                            <td>
                                @((item.Price).ToString("c"))
                            </td>
                            <td>
                                <a asp-action="ProductEdit" asp-route-productId="@item.ProductId" class="btn btn-success">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="ProductDelete" asp-route-productId="@item.ProductId" class="btn btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
