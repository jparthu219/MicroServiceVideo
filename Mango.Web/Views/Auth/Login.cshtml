@model LoginRequestDto

<form method="post">
    <div class="container border p-4 shadow-sm rounded-3 mt-5" style="max-width: 550px;">
        <div class="row text-center mb-4">
            <h1 class="text-primary"><i class="bi bi-box-arrow-in-right me-2"></i>Login</h1>
            <p class="text-muted">Enter your credentials to access your account</p>
        </div>

        <div class="row">
            <div class="col-12 mb-3">
                <label asp-for="UserName" class="form-label fw-semibold">Username / Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                    <input asp-for="UserName" class="form-control" placeholder="Enter username or email" />
                </div>
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="col-12 mb-4">
                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="col-12 mb-3">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </div>

            <div class="col-12 text-center">
                <span class="text-muted">Don't have an account?</span>
                <a asp-action="Register" class="text-primary text-decoration-none fw-semibold"> Register here</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
